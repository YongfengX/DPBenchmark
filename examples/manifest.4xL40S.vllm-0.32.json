  "engine": {
    "max_num_seqs": 256,
    "max_num_batched_tokens": 8192,
    "max_model_len": 32768,
    "prefix_caching": false,
    "speculative_decoding": false,
    "async_scheduling": false,
    "cuda_graph": true,
    "eplb": null
  },
  "trace": {
    "level": "L0",
    "layer_sample_every": null,
    "clock": "monotonic_ns"
  },
  "workload": {
    "scenario": "template",
    "seed": 0,
    "fingerprint": "template",
    "n_requests": 1
  },
  "replay": {
    "mode": "test"
  },
  "policy": {
    "dispatch": "rr",
    "admission": "immediate"
  }
}
